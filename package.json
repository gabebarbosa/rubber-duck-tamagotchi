{
  "name": "rubber-duck-tamagotchi",
  "displayName": "Rubber Duck Tamagotchi",
  "description": "Seu companheiro de código que evolui com commits, branches e pushes!",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:duckTamagotchiView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "duck-explorer",
          "title": "Duckagotchi",
          "icon": "$(heart)"
        }
      ]
    },
    "views": {
      "duck-explorer": [
        {
          "type": "webview",
          "id": "duckTamagotchiView",
          "name": "Seu Patinho"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}